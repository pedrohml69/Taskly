rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/profile/main {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && !('password' in request.resource.data);

      allow delete: if false;
    }

    match /users/{uid}/tasks/{taskId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function hasValidTaskFields(data) {
        return data.keys().hasAll(['nome', 'data', 'horario', 'concluida'])
          && data.keys().hasOnly(['nome', 'data', 'horario', 'concluida'])
          && data.nome is string
          && data.nome.size() > 0
          && data.data is string
          && data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.horario is string
          && data.horario.matches('^[0-9]{2}:[0-9]{2}$')
          && data.concluida is bool;
      }

      allow read: if isOwner();
      allow create: if isOwner() && hasValidTaskFields(request.resource.data);
      allow update: if isOwner()
        && hasValidTaskFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['concluida']);
      allow delete: if isOwner();
    }

    match /users/{uid}/projects/{projectId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function hasValidProjectFields(data) {
        return data.keys().hasAll(['nome', 'descricao', 'ordem'])
          && data.keys().hasOnly(['nome', 'descricao', 'ordem'])
          && data.nome is string
          && data.nome.size() > 0
          && data.descricao is string
          && data.ordem is number;
      }

      allow read: if isOwner();
      allow create, update: if isOwner()
        && hasValidProjectFields(request.resource.data);
      allow delete: if isOwner();

      match /boards/{boardId} {
        function isOwnerWithProject() {
          return request.auth != null
            && request.auth.uid == uid
            && exists(
              /databases/$(database)/documents/users/$(uid)/projects/$(projectId)
            );
        }

        function hasValidBoardFields(data) {
          return data.keys().hasAll(['nome', 'ordem', 'cor', 'itens'])
            && data.keys().hasOnly(['nome', 'ordem', 'cor', 'itens'])
            && data.nome is string
            && data.nome.size() > 0
            && data.ordem is number
            && data.cor in ['quadro-azul', 'quadro-amarelo', 'quadro-vermelho']
            && data.itens is list;
        }

        allow read: if isOwnerWithProject();
        allow create, update: if isOwnerWithProject()
          && hasValidBoardFields(request.resource.data);
        allow delete: if isOwnerWithProject();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
