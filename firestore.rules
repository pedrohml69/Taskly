rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/profile/main {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function isVerifiedOwner() {
        return isOwner() && request.auth.token.email_verified == true;
      }

      function hasValidProfileFields(data) {
        return request.auth != null
          && data.name is string
          && data.email == request.auth.token.email
          && !('password' in data);
      }

      allow read: if isVerifiedOwner();
      allow create: if isOwner()
        && hasValidProfileFields(request.resource.data);
      allow update: if isVerifiedOwner()
        && hasValidProfileFields(request.resource.data);

      allow delete: if false;
    }

    match /users/{uid}/tasks/{taskId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email_verified == true;
      }

      function hasValidTaskFields(data) {
        return data.keys().hasAll(['nome', 'data', 'horario', 'concluida'])
          && data.keys().hasOnly(['nome', 'data', 'horario', 'concluida'])
          && data.nome is string
          && data.nome.size() > 0
          && data.data is string
          && data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.horario is string
          && data.horario.matches('^[0-9]{2}:[0-9]{2}$')
          && data.concluida is bool;
      }

      allow read: if isOwner();
      allow create: if isOwner() && hasValidTaskFields(request.resource.data);
      allow update: if isOwner()
        && hasValidTaskFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['concluida']);
      allow delete: if isOwner();
    }

    match /users/{uid}/projects/{projectId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email_verified == true;
      }

      function hasValidRoutineField(data) {
        return data is map
          && data.keys().hasOnly(['horario'])
          && data.horario is string
          && data.horario.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
      }

      function hasValidProjectFields(data) {
        return (data.keys().hasOnly(['nome', 'descricao', 'ordem'])
          || data.keys().hasOnly(['nome', 'descricao', 'ordem', 'rotina']))
          && data.nome is string
          && data.nome.size() > 0
          && data.descricao is string
          && data.ordem is number
          && (!('rotina' in data) || hasValidRoutineField(data.rotina));
      }

      allow read: if isOwner();
      allow create, update: if isOwner()
        && hasValidProjectFields(request.resource.data);
      allow delete: if isOwner();

      match /boards/{boardId} {
        function isOwnerWithProject() {
          return request.auth != null
            && request.auth.uid == uid
            && request.auth.token.email_verified == true
            && exists(
              /databases/$(database)/documents/users/$(uid)/projects/$(projectId)
            );
        }

        function hasValidBoardFields(data) {
          return data.keys().hasAll(['nome', 'ordem', 'cor', 'itens'])
            && data.keys().hasOnly(['nome', 'ordem', 'cor', 'itens'])
            && data.nome is string
            && data.nome.size() > 0
            && data.ordem is number
            && data.cor in ['quadro-azul', 'quadro-amarelo', 'quadro-vermelho']
            && data.itens is list;
        }

        function isFixedBoard() {
          return boardId in [
            'kanban-fazer',
            'kanban-fazendo',
            'kanban-feito'
          ];
        }

        function isFixedBoardData(data) {
          return (boardId == 'kanban-fazer'
              && data.nome == 'To Do'
              && data.ordem == 0
              && data.cor == 'quadro-azul')
            || (boardId == 'kanban-fazendo'
              && data.nome == 'Doing'
              && data.ordem == 1
              && data.cor == 'quadro-amarelo')
            || (boardId == 'kanban-feito'
              && data.nome == 'Done'
              && data.ordem == 2
              && data.cor == 'quadro-vermelho');
        }

        function isReviewBoardData(data) {
          return boardId == 'kanban-revisar'
            && data.nome == 'Review'
            && data.ordem == 3
            && data.cor == 'quadro-amarelo';
        }

        allow read: if isOwnerWithProject();
        allow create: if isOwnerWithProject()
          && hasValidBoardFields(request.resource.data)
          && (isFixedBoardData(request.resource.data)
            || isReviewBoardData(request.resource.data));
        allow update: if isOwnerWithProject()
          && hasValidBoardFields(request.resource.data)
          && (isFixedBoard() || boardId == 'kanban-revisar')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itens']);
        allow delete: if isOwnerWithProject()
          && (boardId == 'kanban-revisar');
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
